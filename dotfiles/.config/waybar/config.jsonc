{
  // --- General ---

  "layer": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,

  // --- Modules ---

  "modules-left": [ "niri/workspaces" ],
  "modules-center": [ "clock" ],
  "modules-right": [ "battery", "network", "wireplumber", "custom/menu" ],

  // --- Left ---

  "niri/workspaces": {
    "format": "{index}"
  },

  // --- Center ---

  "clock": {
    "format": "{0:%d.%m.%Y} {0:%H:%M:%S}",
    "interval": 1,
    "tooltip": false
  },

  // --- Right ---

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": [ "\uf244", "\uf243", "\uf242", "\uf241", "\uf240" ],
    "tooltip": false
  },

  "network": {
    "format-ethernet": "\uf6ff",
    "format-wifi": "\uf1eb {essid}",
    "format-disconnected": "\uf1eb Disconnected",
    "tooltip": false
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf6a9 Muted",
    "format-icons": [ "\uf027", "\uf6a8", "\uf028" ],
    "on-click": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.3",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "",
    "on-scroll-down": "",
    "tooltip": false
  },

  "custom/menu": {
    "format": "\uf011",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menu.xml",
    "menu-actions": {
      "poweroff": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    },
    "tooltip": false
  }
}
